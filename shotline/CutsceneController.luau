-- Writes the optional CutsceneController module into ReplicatedStorage/Shotline.
-- Saves rewriting require+Play per cutscene. No plugin dep at runtime, same as Exporter output.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CutsceneController = {}

local CONTROLLER_SOURCE = table.concat({
	"-- CutsceneController, generated by Shotline. Optional convenience API.",
	"-- Usage: local CutsceneController = require(game:GetService(\"ReplicatedStorage\").Shotline.CutsceneController)",
	"--        CutsceneController.Play(\"MyCutscene\")",
	"",
	"local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")",
	"",
	"local CutsceneController = {}",
	"",
	"function CutsceneController.Play(name, camera)",
	"\tlocal cutscenesFolder = ReplicatedStorage:WaitForChild(\"Shotline\"):WaitForChild(\"Cutscenes\")",
	"\tlocal moduleScript = cutscenesFolder:WaitForChild(name)",
	"\tlocal cutscene = require(moduleScript)",
	"\tcutscene.Play(camera)",
	"end",
	"",
	"return CutsceneController",
}, "\n")

local function getOrCreateFolder(parent, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function CutsceneController.IsInstalled()
	local shotline = ReplicatedStorage:FindFirstChild("Shotline")
	return shotline ~= nil and shotline:FindFirstChild("CutsceneController") ~= nil
end

function CutsceneController.Install()
	local shotline = getOrCreateFolder(ReplicatedStorage, "Shotline")
	local existing = shotline:FindFirstChild("CutsceneController")
	if existing then
		existing:Destroy()
	end

	local moduleScript = Instance.new("ModuleScript")
	moduleScript.Name = "CutsceneController"
	moduleScript.Source = CONTROLLER_SOURCE
	moduleScript.Parent = shotline

	return moduleScript
end

function CutsceneController.Uninstall()
	local shotline = ReplicatedStorage:FindFirstChild("Shotline")
	local existing = shotline and shotline:FindFirstChild("CutsceneController")
	if existing then
		existing:Destroy()
	end
end

return CutsceneController
